# Backend API
API_BASE=https://api.free-time.me

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only. Never expose this key through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Support and developer email notifications (Resend)
RESEND_API_KEY=re_your_api_key
# Must use a sender/domain verified in Resend for production.
EMAIL_FROM=Luma Support <support@your-domain.example>
EMAIL_NOTIFICATION_TO=FreetimeMaker@proton.me

# Secret header used by the Supabase Database Webhook for luma_submissions.
# Generate a long random value and configure the same value as the
# x-luma-webhook-secret header in the Supabase webhook settings.
LUMA_STATUS_WEBHOOK_SECRET=replace-with-a-long-random-secret
